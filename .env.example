# Copy this file to `.env` and fill in real values.
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
# (2-factor authentication must be enabled on the Google account.)

JARVIS_EMAIL_USER=you@gmail.com
JARVIS_EMAIL_PASS=your-gmail-app-password

# Google Gemini API key — required for LLM-based intent parsing.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Optional model override (default: gemini-2.0-flash)
# JARVIS_GEMINI_MODEL=gemini-2.0-pro

# Optional path overrides (defaults: ~/Music, ~/Movies, repo parent dir)
# JARVIS_MUSIC_DIR=
# JARVIS_MOVIE_DIR=
# JARVIS_PROJECTS_DIR=
