# Copy this file to `.env` and fill in real values.
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
# (2-factor authentication must be enabled on the Google account.)

JARVIS_EMAIL_USER=you@gmail.com
JARVIS_EMAIL_PASS=your-gmail-app-password

# OpenAI API key — required for LLM-based intent parsing.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional model override (default: gpt-4o-mini — cheapest function-calling model)
# JARVIS_OPENAI_MODEL=gpt-4o

# Optional path overrides (defaults: ~/Music, ~/Movies, repo parent dir)
# JARVIS_MUSIC_DIR=
# JARVIS_MOVIE_DIR=
# JARVIS_PROJECTS_DIR=
