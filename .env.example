# Copy this file to `.env` and fill in real values.
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
# (2-factor authentication must be enabled on the Google account.)

JARVIS_EMAIL_USER=you@gmail.com
JARVIS_EMAIL_PASS=your-gmail-app-password

# Anthropic API key — required for LLM-based intent parsing.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (default: claude-haiku-4-5)
# JARVIS_CLAUDE_MODEL=claude-sonnet-4-6

# Optional path overrides (defaults: ~/Music, ~/Movies, repo parent dir)
# JARVIS_MUSIC_DIR=
# JARVIS_MOVIE_DIR=
# JARVIS_PROJECTS_DIR=
